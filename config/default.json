{
  "server": {
    "host": "0.0.0.0",
    "port": 3000,
    "auth": null
  },
  "paths": {
    "audioLibrary": "./audio_library",
    "database": "./data/fx-explorer.db",
    "trash": null,
    "tmp": null
  },
  "scanner": {
    "acceptedExtensions": [".wav", ".mp3", ".aif", ".aiff", ".aac", ".ogg", ".oga", ".opus", ".flac", ".m4a", ".wma"],
    "ignoreHidden": true,
    "ignoreFolders": ["@eaDir", "#recycle", "#snapshot", "lost+found"],
    "scanOnFirstStart": true,
    "statConcurrency": 8,
    "probeConcurrency": 2
  },
  "ffmpeg": {
    "ffmpeg": "ffmpeg",
    "ffprobe": "ffprobe",
    "maxJobs": 2
  },
  "ui": {
    "copyPathPrefix": ""
  }
}
